# Build trees
build/
build-app/
build-native/
build-win/
# zstd's own CMake lives at .../zstd/build/cmake. The unanchored `build/`
# above would drop it; the CI already failed on that exact path.
!tools/rt64/src/contrib/zstd/build/
!tools/rt64/src/contrib/zstd/build/**
dist/
cmake-build-*/
**/CMakeFiles/
**/CMakeCache.txt
compile_commands.json

# Snapshots of the recompiler output. Only RecompiledFuncs/ is the real source.
RecompiledFuncs.bak.*/
RecompiledFuncs-antes-merge.tar.gz
*.tar.gz

# Reference ports and the abandoned fallback project. Useful locally for
# comparison, far too large to carry in the repository.
references/
projects/*/references/
projects/turok2-decomp-mips-fallback/

# ROMs and anything derived from them are never committed.
*.z64
*.n64
*.v64
baserom*
*.bin

# Diagnostics and captures from bring-up sessions
*.log
captures/
saves/
runtime-data/
# Bring-up notes for this port only. Unanchored `analysis/` also ate
# rabbitizer's `src/analysis` and `include/analysis`, which the CI needs.
projects/turok2-decomp/analysis/
flakiness/
deliverables/
*.rej
*.rej.orig
*.mov
*.mp4

# Isolated Angrylion/Mupen A/B (ROM, clones, plugins, generated cfg).
# Keep tools/angrylion-ab/launch-turok2.sh tracked.
tools/angrylion-ab/src/
tools/angrylion-ab/build/
tools/angrylion-ab/plugins/
tools/angrylion-ab/rom/
tools/angrylion-ab/config/
tools/angrylion-ab/screenshots/

# The dependencies under tools/ were standalone git repositories. Their
# histories are parked here so the move stays reversible, but they are not part
# of this repository.
.git.local/

# Editor and OS
.DS_Store
.cursor/
.vscode/
.idea/
