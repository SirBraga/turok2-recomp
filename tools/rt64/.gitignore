*.vs
*.db
*.log
*.dll
*.exe
*.lib
# Vendored Windows binaries the build copies next to the exe. Without these
# exceptions the CI configures, then fails at link or at first launch.
!src/contrib/mupen64plus-win32-deps/**/*.dll
!src/contrib/mupen64plus-win32-deps/**/*.lib
!src/contrib/dxc/bin/x64/*.exe
!src/contrib/dxc/bin/x64/*.dll
!src/contrib/dxc/lib/x64/*.lib
*.exp
*.ipdb
*.iobj
*.tlog
*.recipe
*.FileListAbsolute.txt
*.idb
*.hlsl.h
*.dxil.h
*.spirv.h
*.bat
*.rw
*.rw.h
*.obj
*.pdb
/build/
# The unanchored form also matched src/contrib/zstd/build/cmake, which is
# source, not a build tree.
!src/contrib/zstd/build/
!src/contrib/zstd/build/**
.vscode/
.idea
cmake-build-debug*
.DS_Store
